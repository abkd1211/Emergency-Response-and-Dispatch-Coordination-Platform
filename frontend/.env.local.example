# ─── API ──────────────────────────────────────────────────
# Point to your API gateway
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── WebSocket ────────────────────────────────────────────
# Point DIRECTLY to dispatch service (not the gateway) for low-latency real-time
NEXT_PUBLIC_DISPATCH_WS_URL=http://localhost:3003

# ─── Maps ─────────────────────────────────────────────────
# Get a free token at: https://account.mapbox.com
# Free tier: 50,000 map loads/month — more than enough for a project
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
